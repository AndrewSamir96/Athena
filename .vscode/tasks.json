{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Athena: Backend",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "athena",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Athena: Frontend",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "athena",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Athena",
      "dependsOn": [
        "Athena: Backend",
        "Athena: Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}